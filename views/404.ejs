<%#
  Shown for any URL the app does not recognize.

  Expects: title, current, url
%>
<%- include('partials/head', { title: title }) %>
<%- include('partials/header', { current: current }) %>

<main class="page">
  <h1>Page not found</h1>
  <p>There is nothing at <code><%= url %></code>.</p>
  <p><a href="/">Back to your assignments</a></p>
</main>

<%- include('partials/footer') %>
